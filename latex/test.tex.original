			Attention U-Net & 77.7 & 84.2 & 63.0 & 71.0 \\
			SegNet & 70.5 & 74.4 & 72.5 & 44.7 \\
			PSPNet & 72.5 & 74.6 & 73.6 & 44.7 \\
			DeepCrack & 65.5 & 76.0 & 70.4 & 76.6 \\
			BMS-YOLO & 89.7 & 87.4 & 74.5 & 76.3 \\
			\bottomrule
		\end{tabular}
		\label{tab:compare_cfd}
	\end{table*}
	
	\begin{table*}[htbp]
		\centering
		\caption{DeepCrack数据集上不同方法的性能对比}
		\begin{tabular}{cccccc}
			\toprule
			方法 & 精确率(\%) & 召回率(\%) & Dice(\%) & mIoU(\%) \\
			\midrule
			U-Net & 84.9 & 93.1 & 77.7 & 81.3 \\
			Attention U-Net & 92.1 & 85.2 & 77.5 & 80.8 \\
			PSPNet & 86.9 & 95.2 & 81.5 & 84.1 \\
			TCDNet & 94.3 & 82.7 & 88.3 & 89.2 \\
			Swin-T & 91.0 & 68.7 & 78.3 & 81.8 \\
